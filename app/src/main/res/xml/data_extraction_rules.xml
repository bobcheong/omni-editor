<?xml version="1.0" encoding="utf-8"?>
<!-- NFR-S1: sessions, rules and themes back up; secrets and caches never do. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="file" path="cache" />
        <exclude domain="file" path="backups" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
